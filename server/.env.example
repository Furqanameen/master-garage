# Copy to server/.env for local development:
#   cp server/.env.example server/.env
# All keys the app reads are listed. Live-site values are already filled.

PORT=4000
NODE_ENV=development

# Local PostgreSQL (see README: npm run db:create)
DATABASE_URL=postgres://furqan:furqan@localhost:5432/mastermechanics
DATABASE_SSL=false

# Canonical tags, sitemap.xml, robots.txt Sitemap:, JSON-LD url
SITE_URL=http://localhost:4000

# Missing /wp-content/uploads/* files redirect here until they exist locally
MEDIA_FALLBACK_BASE=https://mastermechanics.ae

# Enquiry form emails. Comma-separated inboxes. Fill SMTP_PASS (mailbox password).
LEAD_EMAIL_TO=carcare@mastermechanics.ae
SMTP_HOST=mail.mastermechanics.ae
SMTP_TLS_SERVERNAME=prod.phx3.secureserver.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=carcare@mastermechanics.ae
SMTP_PASS=kZU1=NCxKUgtmj2
SMTP_FROM=Master Mechanics <carcare@mastermechanics.ae>

# Optional lead webhook (Slack / Make / Zapier). Leave blank to disable.
LEAD_WEBHOOK_URL=

# DIP 2 workshop pin. Public map link: https://rb.gy/g6j5r0
GEO_LAT=24.9685316
GEO_LNG=55.1922678

# Admin dashboard → http://localhost:5173/admin  (local defaults only)
ADMIN_USER=admin
ADMIN_PASSWORD=admin123
SESSION_SECRET=replace-with-openssl-rand-hex-32-for-anything-public
